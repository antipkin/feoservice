# Наследуется из корневого .env через docker-compose
# Локально (без Docker) можно использовать эти значения:
DB_HOST=postgres
DB_PORT=5432
DB_USER=feoservice
DB_PASSWORD=feoservice_secret
DB_NAME=feoservice
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60